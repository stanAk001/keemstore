# Production: the public URL of the API on Render (no trailing slash).
# Leave empty in development — Vite proxies /api to the local server.
VITE_API_URL=

# Development only: where Vite proxies /api (default http://localhost:4000).
VITE_DEV_API_PROXY=http://localhost:4000

# Set API_URL (not VITE_) in the Vercel project settings for middleware.js
# (crawler share pages, sitemap.xml, robots.txt):
# API_URL=https://your-api.onrender.com
