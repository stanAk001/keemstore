{
  "name": "keemstore-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node db/migrate.js && node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "db:reset": "node --env-file-if-exists=.env db/migrate.js --reset && node --env-file-if-exists=.env db/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/affiliate.test.js test/api.test.js",
    "db:catalog": "node --env-file-if-exists=.env db/seed-catalog.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
